{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "update": "disable",
  "plugins": [
    "@dietrichgebert/ponytail",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "tui": {
    "scroll_speed": 1,
    "scroll_acceleration": {
      "enabled": false
    }
  },
  "instructions": [
    "AGENTS.md",
    "README.md",
    ".agent/*.md"
  ],
  "provider": {
    "procyde": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Procyde Intelligent Assistant",
      "options": {
        "baseURL": "https://pia.procyde.online/v1",
        "apiKey": "{env:PIA_API_KEY}"
      },
      "models": {
        "PIA-1": {
          "name": "PIA-1"
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "nixos": {
        "type": "local",
        "command": [
          "nix",
          "run",
          "github:utensils/mcp-nixos",
          "--"
        ],
        "disabled": false
      }
    }
  },
  "permissions": [
    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf*", "effect": "ask" },
    { "action": "shell", "resource": "curl *-X POST*", "effect": "ask" },
    { "action": "shell", "resource": "curl *-X PUT*", "effect": "ask" },
    { "action": "shell", "resource": "curl *-X PATCH*", "effect": "ask" },
    { "action": "shell", "resource": "curl *-X DELETE*", "effect": "ask" },
    { "action": "shell", "resource": "curl *--request*", "effect": "ask" },
    { "action": "shell", "resource": "curl * -d *", "effect": "ask" },
    { "action": "shell", "resource": "curl *--data*", "effect": "ask" },
    { "action": "shell", "resource": "curl *--json*", "effect": "ask" },
    { "action": "shell", "resource": "curl * -F *", "effect": "ask" },
    { "action": "shell", "resource": "curl * -T *", "effect": "ask" },
    { "action": "shell", "resource": "curl *| *", "effect": "ask" },
    { "action": "shell", "resource": "git *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "git status*", "effect": "allow" },
    { "action": "shell", "resource": "git diff*", "effect": "allow" },
    { "action": "shell", "resource": "git log*", "effect": "allow" },
    { "action": "shell", "resource": "git show*", "effect": "allow" },
    { "action": "shell", "resource": "git branch", "effect": "allow" },
    { "action": "shell", "resource": "ls*", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl get *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl describe *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl logs *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl top *", "effect": "allow" },
    { "action": "shell", "resource": "curl *", "effect": "allow" },
    { "action": "shell", "resource": "kubectl apply*", "effect": "ask" },
    { "action": "shell", "resource": "kubectl delete*", "effect": "ask" },
    { "action": "shell", "resource": "kubectl patch*", "effect": "ask" },
    { "action": "shell", "resource": "kubectl edit*", "effect": "ask" },
    { "action": "shell", "resource": "kubectl exec*", "effect": "ask" },
    { "action": "shell", "resource": "helm upgrade*", "effect": "ask" },
    { "action": "shell", "resource": "helm uninstall*", "effect": "ask" },
    { "action": "shell", "resource": "argocd app sync*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "list", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" }
  ]
}
