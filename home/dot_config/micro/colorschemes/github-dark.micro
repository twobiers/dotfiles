# GitHub Dark color scheme for micro
# Palette: https://github.com/primer/github-vscode-theme (dark_default)

# Base
color-link default "#c9d1d9,#0d1117"
color-link comment "#8b949e"

# Syntax
color-link identifier "#d2a8ff"
color-link identifier.var "#ffa657"
color-link identifier.const "#79c0ff"
color-link identifier.macro "#d2a8ff"
color-link constant "#79c0ff"
color-link constant.bool "#79c0ff"
color-link constant.bool.true "#79c0ff"
color-link constant.bool.false "#79c0ff"
color-link constant.number "#79c0ff"
color-link constant.specialChar "#a5d6ff"
color-link constant.string "#a5d6ff"
color-link constant.string.url "#a5d6ff"
color-link keyword "#ff7b72"
color-link keyword.flow "#d2a8ff"
color-link statement "#ff7b72"
color-link operator "#ff7b72"
color-link symbol "#c9d1d9"
color-link symbol.brackets "#ffa657"
color-link symbol.tag "#7ee787"
color-link type "#ffa657"
color-link preproc "#ffa657"
color-link special "#79c0ff"
color-link todo "#ffa657,bold"
color-link under-cursor "#c9d1d9,#1d3b6d"
color-link esc-seq "#c9d1d9,bold"

# UI
# micro uses only the fg value of cursor-line/color-column as the background paint
color-link cursor-line "#161b22"
color-link cursor-line-number "#c9d1d9,#161b22"
color-link line-number "#484f58"
color-link current-line-number "#c9d1d9"
color-link color-column "#161b22"
color-link error-message "#f85149"
color-link error-cursor "#f85149"
color-link gutter-error "#f85149"
color-link gutter-warning "#d29922"
color-link highlight "#c9d1d9,#264f78"
color-link selection "#c9d1d9,#1d3b6d"
color-link hlsearch "#0d1117,#e3b341"
color-link match-brace "#c9d1d9,#1d3b6d"
color-link secondary "#c9d1d9,#161b22"
color-link statusline "#c9d1d9,#161b22"
color-link statusline.bard "#c9d1d9,#161b22"
color-link tabbar "#8b949e,#0d1117"
color-link tabbar.active "#c9d1d9,#161b22"
color-link message "#c9d1d9,#0d1117"
color-link message.error "#f85149,#0d1117"
color-link divider "#161b22"
color-link ruler "#484f58"
color-link scrollbar "#161b22"
color-link indent-char "#21262d"
color-link ignore ""
